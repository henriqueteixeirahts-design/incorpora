// Incorpora — schema de banco
// Escopo desta versão: FASE 1 (Fundação da Plataforma) + FASE 2 (Empreendimentos)
// conforme docs/PRD Mestre rev00.docx e docs/Arquitetura Incorpora REV00.docx.
//
// Decisões de modelagem relevantes:
// - Todos os ids são UUID para compatibilidade nativa com Supabase Auth (auth.users.id).
// - Multiempresa desde o início: Organization é o tenant raiz; SPE, Development e
//   demais entidades pendem dele. Permissões são resolvidas por AccessGrant, com
//   escopo opcional em SPE e/ou Development (PRD seção 23).
// - Unidade principal e unidade acessória (vaga, escaninho, depósito etc.) usam a
//   MESMA tabela Unit (campo isAccessory), evitando duplicar ~20 colunas comuns.
//   O vínculo entre uma unidade principal e suas acessórias é modelado em UnitLink
//   (arquitetura doc seção 3 e seção 25: Unit + AccessoryUnit + UnitLink).
// - UnitStatus já contempla os estados do funil comercial completo (reserva,
//   proposta, contrato, venda) descritos na seção 4 do doc de arquitetura, para que
//   as Fases 3-9 (disponibilidade, propostas, vendas, carteira) não exijam alterar
//   o enum depois. As tabelas de venda/contrato/carteira/indexadores em si (Sale,
//   Contract, ReceivablePortfolio, Installment, IndexRule...) ficam para as Fases
//   6-10, quando o motor financeiro for desenhado com atenção dedicada.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// FASE 1 — FUNDAÇÃO DA PLATAFORMA
// ============================================================================

/// Tenant raiz. Toda a plataforma é multiempresa a partir daqui.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  document  String? // CNPJ da holding/matriz, quando houver
  planTier  String   @default("internal") // "internal" | futuros planos SaaS (Fase 18)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spes                    SpecialPurposeEntity[]
  developments            Development[]
  roles                   Role[]
  accessGrants            AccessGrant[]
  auditEvents             AuditEvent[]
  developmentEvents       DevelopmentEvent[]
  documents               Document[]
  notifications           Notification[]
  settings                Setting[]
  customers               Customer[]
  brokers                 Broker[]
  agencies                RealEstateAgency[]
  reservations            Reservation[]
  proposals               Proposal[]
  sales                   Sale[]
  contracts               Contract[]
  receivablePortfolios    ReceivablePortfolio[]
  indexRules              IndexRule[]
  suppliers               Supplier[]
  costCenters             CostCenter[]
  payables                Payable[]
  bankAccounts            BankAccount[]
  jobRuns                 JobRun[]
  auditRuns               AuditRun[]
  permutantes             Permutante[]
  documentTemplates       DocumentTemplate[]
  contractAmendments      ContractAmendment[]
  contractAssignments     ContractAssignment[]
  contractDistratos       ContractDistrato[]
  collectionContactLogs   CollectionContactLog[]
  renegotiationAgreements RenegotiationAgreement[]
  allocationTemplates     AllocationTemplate[]
  receivables             Receivable[]
  reservationRules        ReservationRule[]
  proposalEvaluationRules ProposalEvaluationRule[]
  commissionReleaseRules  CommissionReleaseRule[]
  distratoRules           DistratoRule[]
  collectionRules         CollectionRule[]
  renegotiationRules      RenegotiationRule[]

  @@map("organizations")
}

/// Usuário da plataforma (funcionário da incorporadora, corretor, investidor,
/// cliente do portal etc.). O id é o mesmo uuid do Supabase Auth (auth.users.id).
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessGrants             AccessGrant[]
  auditEvents              AuditEvent[]        @relation("AuditEventActor")
  developmentEvents        DevelopmentEvent[]  @relation("DevelopmentEventActor")
  uploadedDocuments        Document[]          @relation("DocumentUploadedBy")
  notifications            Notification[]
  unitStatusChanges        UnitStatusHistory[] @relation("UnitStatusChangedBy")
  createdDocumentTemplates DocumentTemplate[]  @relation("DocumentTemplateCreatedBy")

  @@map("users")
}

/// Papel atribuível a um usuário (Diretor, Comercial, Financeiro, Investidor...).
/// organizationId nulo = papel de sistema (predefinido, reaproveitável por toda org).
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  accessGrants AccessGrant[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Ação granular sobre um recurso, ex.: "unit.create", "proposal.approve".
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  resource    String // ex.: "unit", "proposal", "installment"
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  CANCEL
  EXPORT
  VIEW_SENSITIVE
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Concede um Role a um usuário, com escopo opcional por SPE e/ou Development.
/// Sem speId/developmentId = acesso a toda a organização (PRD seção 23).
model AccessGrant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  speId          String?  @db.Uuid
  developmentId  String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  spe          SpecialPurposeEntity? @relation(fields: [speId], references: [id], onDelete: Cascade)
  development  Development?          @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, speId, developmentId])
  @@index([organizationId])
  @@map("access_grants")
}

/// SPE — Sociedade de Propósito Específico, dona jurídica do(s) empreendimento(s).
enum SpeStatus {
  ACTIVE // ativa
  IN_FORMATION // em constituição
  CLOSED // encerrada
}

model SpecialPurposeEntity {
  id                       String     @id @default(uuid()) @db.Uuid
  organizationId           String     @db.Uuid
  name                     String // razão social
  tradeName                String? // nome fantasia
  document                 String // CNPJ, validado por dígito verificador em novos cadastros/edições
  nire                     String? // registro na Junta Comercial
  foundedAt                DateTime? // data de constituição
  legalNature              String? // natureza jurídica (ex.: "206-2 Sociedade Empresária Limitada")
  cnae                     String? // CNAE principal
  status                   SpeStatus  @default(ACTIVE)
  email                    String?
  phone                    String?
  website                  String?
  address                  String? // legado — cadastros anteriores ao endereço estruturado. Não é mais escrito por cadastros novos, mas nunca apagado.
  zipCode                  String?
  street                   String?
  number                   String?
  complement               String?
  neighborhood             String?
  city                     String?
  state                    String?    @db.VarChar(2)
  isActive                 Boolean    @default(true)
  // Contábil (aba 7) — regime tributário
  taxRegime                TaxRegime?
  retOptionSince           DateTime? // optante pelo RET desde
  event109Cnpj             String? // inscrição do evento 109 — Patrimônio de Afetação, exigida pra RET
  // Contábil — escrituração e responsáveis
  accountantName           String?
  accountantCrc            String?
  accountantEmail          String?
  accountantPhone          String?
  accountingFirm           String? // escritório de contabilidade
  externalAccountingCode   String? // código da empresa no sistema contábil externo — chave do De-Para da Fase 2
  chartOfAccountsRef       String? // plano de contas: código de referência — outra chave do De-Para
  // Contábil — obrigações
  dimobRequired            Boolean    @default(false)
  efdContributionsRequired Boolean    @default(false)
  accountingNotes          String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developments Development[]
  accessGrants AccessGrant[]
  payables     Payable[]
  bankAccounts SpeBankAccount[]
  partners     SpePartner[]
  investors    SpeInvestor[]
  lands        SpeLand[]
  receivables  Receivable[]

  @@unique([organizationId, document])
  @@map("special_purpose_entities")
}

enum TaxRegime {
  ACTUAL_PROFIT // Lucro Real
  PRESUMED_PROFIT // Lucro Presumido
  SIMPLES_NACIONAL
  RET // Regime Especial de Tributação
}

enum SpeDocumentHolderType {
  INDIVIDUAL // pessoa física — documento é CPF
  COMPANY // pessoa jurídica — documento é CNPJ
}

enum SpePartnerRole {
  ADMINISTRATOR // sócio administrador
  QUOTAHOLDER // sócio quotista
  OTHER
}

/// Sócio do quadro societário da SPE. Permite histórico (endDate) para
/// alterações societárias ao longo do tempo — não é sobrescrito, é encerrado
/// e um novo registro é criado quando a composição muda.
model SpePartner {
  id               String                @id @default(uuid()) @db.Uuid
  speId            String                @db.Uuid
  type             SpeDocumentHolderType
  name             String
  document         String // CPF ou CNPJ, validado por dígito verificador conforme type
  participationPct Decimal               @db.Decimal(6, 3) // percentual de participação
  role             SpePartnerRole?
  startDate        DateTime?
  endDate          DateTime? // preenchido quando o sócio sai — mantém histórico
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  spe SpecialPurposeEntity @relation(fields: [speId], references: [id], onDelete: Cascade)

  @@map("spe_partners")
}

enum SpeInvestorModality {
  EQUITY // participação
  LOAN // mútuo
  PHYSICAL_EXCHANGE // permuta física
  FINANCIAL_EXCHANGE // permuta financeira
  OTHER
}

enum SpeInvestorLoanInterestPeriod {
  MONTHLY // % a.m.
  YEARLY // % a.a.
}

/// Investidor da SPE — distinto de sócio: pode ser mutuante, permutante ou
/// aportador sem participação societária formal. Campos de comprometido/
/// condições de mútuo/conta de devolução (docs/ESPEC_APORTES_INVESTIDORES.md,
/// Parte 1) — `contributedCapital` (legado) segue existindo como valor
/// informado manualmente antes deste módulo; o total aportado de verdade
/// agora vem da soma de `contributions`.
model SpeInvestor {
  id                     String                @id @default(uuid()) @db.Uuid
  speId                  String                @db.Uuid
  type                   SpeDocumentHolderType
  name                   String
  document               String // CPF ou CNPJ, validado por dígito verificador conforme type
  email                  String
  phone                  String
  modality               SpeInvestorModality
  contributedCapital     Decimal?              @db.Decimal(14, 2) // capital aportado (R$) — legado, anterior ao módulo de aportes
  resultParticipationPct Decimal?              @db.Decimal(6, 3) // percentual de participação no resultado
  contributionDate       DateTime?
  notes                  String?

  // Capital comprometido total — Parte 1.1. Nulo = sem teto definido.
  committedCapital Decimal? @db.Decimal(14, 2)

  // Conta bancária de devolução do investidor — externa ao cadastro central
  // de contas (que é só das contas da própria organização/SPE), por isso
  // campos livres em vez de FK.
  returnBankName    String?
  returnBankAgency  String?
  returnBankAccount String?
  returnPixKeyType  String?
  returnPixKeyValue String?

  // Condições de mútuo (Parte 1.2) — só fazem sentido quando modality = LOAN.
  // O cálculo do saldo devedor (memória de juros/correção) é etapa 5 da
  // especificação; aqui só se registram as condições contratadas.
  loanInterestRate   Decimal?                       @db.Decimal(6, 3)
  loanInterestPeriod SpeInvestorLoanInterestPeriod?
  loanIndexRuleId    String?                        @db.Uuid
  loanGraceMonths    Int?
  loanTermMonths     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spe                   SpecialPurposeEntity              @relation(fields: [speId], references: [id], onDelete: Cascade)
  loanIndexRule         IndexRule?                        @relation(fields: [loanIndexRuleId], references: [id])
  contributionForecasts SpeInvestorContributionForecast[]
  contributions         SpeInvestorContribution[]

  @@map("spe_investors")
}

enum SpeContributionForecastOrigin {
  CASH_FLOW_PLANNING // planejamento de caixa
  PUNCTUAL_AGREEMENT // acordo pontual
  CAPITAL_CALL // chamada de capital (documento formal — etapa 3)
}

enum SpeContributionForecastStatus {
  PLANNED // previsto, nada realizado ainda
  PARTIALLY_FULFILLED // baixa parcial por aporte(s) vinculado(s)
  FULFILLED // totalmente baixado
  CANCELLED // cancelado — auditável, nunca apagado
}

/// Previsão de aporte (docs/ESPEC_APORTES_INVESTIDORES.md, Parte 2.1) — sem
/// cronograma rígido, editável/cancelável. `status` é recalculado a partir
/// da soma dos aportes realizados vinculados (nunca setado livremente pelo
/// formulário, exceto CANCELLED).
model SpeInvestorContributionForecast {
  id           String                        @id @default(uuid()) @db.Uuid
  investorId   String                        @db.Uuid
  amount       Decimal                       @db.Decimal(14, 2)
  expectedDate DateTime
  origin       SpeContributionForecastOrigin
  status       SpeContributionForecastStatus @default(PLANNED)
  cancelReason String?
  notes        String?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  investor      SpeInvestor               @relation(fields: [investorId], references: [id], onDelete: Cascade)
  contributions SpeInvestorContribution[]

  @@map("spe_investor_contribution_forecasts")
}

/// Aporte realizado (Parte 2.3) — baixa a previsão vinculada (total ou
/// parcial) quando `forecastId` é informado; pode ser espontâneo (sem
/// previsão). `bankAccountId` aponta pro cadastro central de contas — é a
/// conta da SPE/organização que recebeu, não a do investidor.
model SpeInvestorContribution {
  id              String   @id @default(uuid()) @db.Uuid
  investorId      String   @db.Uuid
  forecastId      String?  @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  creditDate      DateTime
  bankAccountId   String   @db.Uuid
  method          String? // TED/Pix/outro — texto livre
  receiptFilePath String? // caminho no bucket privado "documents"
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investor    SpeInvestor                      @relation(fields: [investorId], references: [id], onDelete: Cascade)
  forecast    SpeInvestorContributionForecast? @relation(fields: [forecastId], references: [id])
  bankAccount BankAccount                      @relation(fields: [bankAccountId], references: [id])

  @@map("spe_investor_contributions")
}

enum LandAcquisitionMethod {
  PURCHASE // compra
  PHYSICAL_EXCHANGE // permuta física
  FINANCIAL_EXCHANGE // permuta financeira
  CAPITAL_CONTRIBUTION // integralização
  OTHER
}

/// Terreno vinculado à SPE. affectationEstablished/affectationRegisteredAt
/// conversam com a aba Contábil (RET, etapa 6) e com a categoria de
/// documento AFFECTATION_DEED (aba Documentação) — o patrimônio de
/// afetação por terreno é o que habilita o RET.
model SpeLand {
  id                      String                 @id @default(uuid()) @db.Uuid
  speId                   String                 @db.Uuid
  // Identificação do imóvel
  registrationNumber      String // matrícula nº
  registryOffice          String // cartório de registro (nome/comarca)
  zipCode                 String?
  street                  String?
  number                  String?
  complement              String?
  neighborhood            String?
  city                    String?
  state                   String?                @db.VarChar(2)
  totalArea               Decimal                @db.Decimal(12, 2) // área total (m²)
  municipalRegistration   String? // inscrição municipal / IPTU
  // Aquisição
  acquisitionMethod       LandAcquisitionMethod?
  previousOwner           String? // vendedor/permutante anterior
  acquisitionValue        Decimal?               @db.Decimal(14, 2)
  acquisitionDate         DateTime?
  // Situação legal
  affectationEstablished  Boolean                @default(false) // patrimônio de afetação constituído?
  affectationRegisteredAt DateTime? // data da averbação da afetação
  encumbrances            String? // ônus/gravames (hipoteca, alienação fiduciária)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  spe                   SpecialPurposeEntity   @relation(fields: [speId], references: [id], onDelete: Cascade)
  exchangeContractLinks ExchangeContractLand[]

  @@map("spe_lands")
}

/// Terrenista/permutante — pessoa (PF/PJ) que recebe unidades ou percentual
/// financeiro em troca do terreno. Mesmo padrão estrutural de `Customer`
/// (docs/ESPEC_PERMUTANTES.md, Parte 1.1), mas modelo próprio: é uma
/// contraparte de negócio, não um comprador.
model Permutante {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  type           CustomerType @default(INDIVIDUAL)
  name           String
  document       String
  email          String?
  phone          String?
  zipCode        String?
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?      @db.VarChar(2)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exchangeContracts ExchangeContract[]

  @@unique([organizationId, document])
  @@map("permutantes")
}

enum ExchangeContractType {
  PHYSICAL // permuta física
  FINANCIAL // permuta financeira
  MIXED // mista
}

enum ExchangeContractStatus {
  ACTIVE
  SETTLED // quitado
  TERMINATED // encerrado
}

/// Contrato de permuta (docs/ESPEC_PERMUTANTES.md, Parte 1). Etapas 1-2:
/// cadastro do contrato + destaque de unidades da permuta física no espelho
/// de vendas. `managedBySystem` só é relevante quando `type` inclui a parte
/// física (PHYSICAL/MIXED) — controla se as unidades destacadas continuam no
/// funil comercial normal (badge "P") ou saem dele (status fixo EXCHANGE).
/// A apuração financeira da permuta física sob gestão e o motor da permuta
/// financeira são as etapas 3-4, ainda não implementadas.
model ExchangeContract {
  id                   String                 @id @default(uuid()) @db.Uuid
  developmentId        String                 @db.Uuid
  permutanteId         String                 @db.Uuid
  type                 ExchangeContractType
  appraisalValue       Decimal?               @db.Decimal(14, 2)
  contractDate         DateTime
  contractDocumentPath String? // caminho no bucket privado "documents"
  notes                String?
  status               ExchangeContractStatus @default(ACTIVE)
  managedBySystem      Boolean? // só relevante se type = PHYSICAL/MIXED
  administrationFeePct Decimal?               @db.Decimal(6, 3) // captado agora; repasse (etapa 3) ainda não calcula sobre isso
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  development Development            @relation(fields: [developmentId], references: [id], onDelete: Restrict)
  permutante  Permutante             @relation(fields: [permutanteId], references: [id], onDelete: Restrict)
  lands       ExchangeContractLand[]
  units       Unit[]

  @@map("exchange_contracts")
}

/// Vínculo N:N entre contrato de permuta e terreno(s) objeto da permuta (a
/// especificação prevê múltiplos terrenos por contrato).
model ExchangeContractLand {
  id                 String @id @default(uuid()) @db.Uuid
  exchangeContractId String @db.Uuid
  landId             String @db.Uuid

  exchangeContract ExchangeContract @relation(fields: [exchangeContractId], references: [id], onDelete: Cascade)
  land             SpeLand          @relation(fields: [landId], references: [id], onDelete: Cascade)

  @@unique([exchangeContractId, landId])
  @@map("exchange_contract_lands")
}

enum BankAccountType {
  CHECKING // corrente
  SAVINGS // poupança
  PAYMENT // conta de pagamento
}

enum BankAccountStatus {
  ACTIVE
  CLOSED
}

/// Cadastro central de contas bancárias (Configurações → Financeiro). SPEs
/// vinculam-se a contas já cadastradas aqui em vez de recadastrar — evita
/// duplicação quando SPEs compartilham banco e prepara a conciliação
/// bancária da Fase 2. Ver docs/ESPEC_CADASTRO_SPE.md, aba 3.
model BankAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  bankCode           String? // código FEBRABAN, quando identificável
  bankName           String // nome do banco (ou "código - nome" quando digitado via sugestão)
  agency             String // agência, com dígito
  account            String // conta, com dígito
  type               BankAccountType
  pixKeyType         String?
  pixKeyValue        String?
  nickname           String?
  status             BankAccountStatus @default(ACTIVE)
  // Saldo inicial pro fluxo de caixa partir do saldo real (Fase B, Parte
  // 4.4) — lançado manualmente por enquanto; a conciliação bancária
  // automática da Fase 2 passa a alimentar isso sozinha.
  openingBalance     Decimal           @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  speLinks      SpeBankAccount[]
  contributions SpeInvestorContribution[]

  @@map("bank_accounts")
}

/// Vínculo explícito e auditável entre SPE e conta bancária central — a lei
/// exige conta específica quando há patrimônio de afetação, então esse
/// relacionamento não pode ser um campo de texto livre.
model SpeBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  speId         String   @db.Uuid
  bankAccountId String   @db.Uuid
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  spe         SpecialPurposeEntity @relation(fields: [speId], references: [id], onDelete: Cascade)
  bankAccount BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([speId, bankAccountId])
  @@map("spe_bank_accounts")
}

/// Trilha de auditoria genérica (before/after) para qualquer entidade do sistema.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String // ex.: "create", "update", "delete", "approve"
  entityType     String // ex.: "Unit", "Development"
  entityId       String
  beforeData     Json?
  afterData      Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

/// Evento central do domínio (espinha dorsal, análoga ao WorkEvent do ObrIA —
/// doc de arquitetura seção 26). Alimenta timeline, notificações e automações
/// de cada empreendimento. Diferente de AuditEvent: é um fato de negócio
/// ("proposta enviada", "parcela vencida"), não um diff técnico de registro.
model DevelopmentEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  developmentId  String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  eventType      String // ex.: "unit.created", "sale.completed", "installment.overdue"
  entityType     String?
  entityId       String?
  payload        Json?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  actor        User?        @relation("DevelopmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, developmentId])
  @@index([eventType])
  @@map("development_events")
}

enum DocumentCategory {
  PLAN // planta
  MEMORIAL // memorial descritivo
  REGISTRATION // matrícula
  CONTRACT
  PROOF // comprovante
  REPORT
  OTHER
  ARTICLES_OF_ASSOCIATION // contrato social / alterações contratuais
  CNPJ_CARD // cartão CNPJ
  CLEARANCE_CERTIFICATE // certidões negativas fiscais, FGTS, trabalhista
  POWER_OF_ATTORNEY // procurações
  AFFECTATION_DEED // termo de afetação / averbação na matrícula
  RET_OPTION_TERM // termo de opção pelo RET (protocolo Receita Federal)
  PERMIT_LICENSE // alvarás e licenças
  FISCAL_DOCUMENT // nota fiscal / boleto / recibo de uma conta a pagar
}

/// Documento genérico, anexável a qualquer entidade via (entityType, entityId).
/// Cobre plantas, memoriais, matrículas e demais arquivos do empreendimento.
/// Quando gerado a partir de um DocumentTemplate (Fase A, Parte 1), guarda a
/// versão exata do modelo usado — rastreabilidade jurídica (a versão em si
/// nunca é apagada, mesmo que o modelo evolua depois).
model Document {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @db.Uuid
  entityType              String // ex.: "Development", "Unit", "Contract"
  entityId                String
  category                DocumentCategory @default(OTHER)
  description             String? // observação livre sobre o anexo
  fileName                String
  fileUrl                 String // caminho no Supabase Storage
  mimeType                String?
  sizeBytes               Int?
  expiresAt               DateTime? // data de validade — usado por certidões; alerta automático de vencimento fica para depois
  documentTemplateId      String?          @db.Uuid
  documentTemplateVersion Int?
  uploadedById            String?          @db.Uuid
  createdAt               DateTime         @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy       User?             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  documentTemplate DocumentTemplate? @relation(fields: [documentTemplateId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@map("documents")
}

enum DocumentTemplateType {
  SALES_CONTRACT // contrato de compra e venda / promessa
  ASSIGNMENT // cessão de direitos
  RESCISSION // distrato
  AMENDMENT // aditivo contratual
  STATEMENT // extrato/demonstrativo (Fase B, Parte 1)
  OTHER // procuração, declaração, livre
}

enum DocumentTemplateStatus {
  ACTIVE
  INACTIVE
}

/// Modelo de documento (Fase A, Parte 1 — motor de templates). Nasce por
/// organização desde o dia 1 (Pilar 4 das Fundações multi-tenant): não há
/// linha "global" compartilhada entre organizações. Versionado por
/// `templateGroupId` (estável entre versões do "mesmo" modelo) +
/// `version` (incrementa a cada edição) — editar nunca sobrescreve a versão
/// anterior, só cria uma nova linha e marca a anterior como INACTIVE. O
/// documento gerado (`Document.documentTemplateId/documentTemplateVersion`)
/// sempre referencia a versão exata usada na geração, mesmo que o modelo
/// mude depois.
model DocumentTemplate {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  templateGroupId String                 @db.Uuid
  version         Int                    @default(1)
  name            String
  type            DocumentTemplateType
  status          DocumentTemplateStatus @default(ACTIVE)
  effectiveDate   DateTime               @default(now())
  content         String // corpo em texto puro com variáveis {{grupo.campo}}
  createdByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                         @relation("DocumentTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  developments DocumentTemplateDevelopment[]
  documents    Document[]

  @@index([organizationId, templateGroupId])
  @@index([organizationId, type, status])
  @@map("document_templates")
}

/// Empreendimentos em que o modelo se aplica — sem nenhuma linha aqui, o
/// modelo se aplica a todos os empreendimentos da organização (spec: "(ou
/// todos)").
model DocumentTemplateDevelopment {
  id                 String @id @default(uuid()) @db.Uuid
  documentTemplateId String @db.Uuid
  developmentId      String @db.Uuid

  documentTemplate DocumentTemplate @relation(fields: [documentTemplateId], references: [id], onDelete: Cascade)
  development      Development      @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@unique([documentTemplateId, developmentId])
  @@map("document_template_developments")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  userId         String              @db.Uuid
  channel        NotificationChannel @default(IN_APP)
  type           String
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

/// Configurações gerais em chave/valor, por organização (ex.: cores do mapa de
/// disponibilidade, prazos padrão de reserva — usadas a partir da Fase 3).
model Setting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("settings")
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILURE
}

enum JobTrigger {
  CRON
  MANUAL
  EVENT
}

/// Registro de execução de job (docs/ESPEC_CONFIABILIDADE_JOBS_AUDITORIA.md,
/// Parte 1). Matéria-prima da tela de Jobs (histórico + executar agora) e da
/// verificação V4 da auditoria de atualização (Parte 2) — "todo job agendado
/// do período tem JobRun de sucesso?". Um job que itera organizações grava
/// um JobRun por organização, nunca um agregado — histórico e auditoria
/// ficam corretos por organização desde o início (preparação multi-tenant).
model JobRun {
  id             String       @id @default(uuid()) @db.Uuid
  jobName        String
  organizationId String?      @db.Uuid // nulo só pra job que não itera por organização (nenhum hoje, mas o contrato permite)
  status         JobRunStatus @default(RUNNING)
  triggeredBy    JobTrigger
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  summary        Json?
  error          String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([jobName, startedAt])
  @@index([organizationId, startedAt])
  @@map("job_runs")
}

enum AuditStatus {
  OK
  ALERT
}

enum AuditCheckCode {
  V1_INDEX_FRESHNESS // frescor dos índices
  V2_CORRECTION_COVERAGE // cobertura da correção
  V3_MEMORY_CONSISTENCY // consistência da memória (centavo a centavo)
  V4_JOB_EXECUTION // execução dos jobs agendados
  V5_SOURCE_DIVERGENCE // divergência contra a fonte oficial (BC)
}

/// Uma rodada da auditoria de atualização (docs/
/// ESPEC_CONFIABILIDADE_JOBS_AUDITORIA.md, Parte 2) — o "double-check"
/// independente do motor de correção. `status` é ALERT se qualquer uma das
/// 5 verificações (AuditCheckResult) vier ALERT. `fullCheck` diferencia a
/// rodada diária (V3 por amostragem) da mensal (V3 completa — todas as
/// parcelas, não só uma amostra).
model AuditRun {
  id             String      @id @default(uuid()) @db.Uuid
  // Desempate monotônico pra "a auditoria mais recente" (getIndexFreshnessWarnings,
  // getLatestAuditRun) — duas rodadas disparadas muito próximas (ou sob fake timer
  // em teste) podem cair no mesmo `startedAt`; `id` é UUID aleatório, não ordena
  // cronologicamente. `sequence` sempre cresce na ordem real de criação.
  sequence       Int         @default(autoincrement())
  organizationId String      @db.Uuid
  status         AuditStatus @default(OK)
  triggeredBy    JobTrigger
  fullCheck      Boolean     @default(false)
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checks       AuditCheckResult[]

  @@index([organizationId, startedAt])
  @@map("audit_runs")
}

/// Resultado de UMA das 5 verificações dentro de uma AuditRun. `summary` é o
/// resumo agregado (contadores); `issues` é o detalhe de cada problema
/// encontrado (ex.: qual parcela, qual índice, valor esperado × encontrado)
/// — a matéria-prima da tela de detalhe de falha.
model AuditCheckResult {
  id         String         @id @default(uuid()) @db.Uuid
  auditRunId String         @db.Uuid
  code       AuditCheckCode
  status     AuditStatus
  summary    Json
  issues     Json?

  auditRun AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([auditRunId])
  @@map("audit_check_results")
}

// ============================================================================
// FASE 2 — EMPREENDIMENTOS
// ============================================================================

enum DevelopmentType {
  RESIDENTIAL_BUILDING
  COMMERCIAL_BUILDING
  MIXED_USE
  HORIZONTAL_CONDOMINIUM
  SUBDIVISION // loteamento
  OTHER
}

/// Empreendimento. Doc de arquitetura seção 2 — cada um tem cadastro e
/// configuração próprios, sempre amarrado a uma SPE.
model Development {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @db.Uuid
  speId                  String          @db.Uuid
  name                   String
  type                   DevelopmentType
  address                String?
  city                   String?
  state                  String?
  launchDate             DateTime?
  expectedDeliveryDate   DateTime?
  actualDeliveryDate     DateTime?
  registrationNumber     String? // número do registro da incorporação
  notaryOffice           String? // cartório
  motherPropertyRecord   String? // matrícula-mãe
  taxRegime              String?
  hasPropertyAffectation Boolean         @default(false) // patrimônio de afetação
  bankAccount            String?
  // Denormalizado por ora: construtora e agência de marketing viram entidades
  // relacionais (Supplier / RealEstateAgency) nas Fases 5 e 12.
  builderCompanyName     String?
  marketingAgencyName    String?

  // Data do Habite-se — gatilho da troca de fase de correção da carteira
  // (PRD seção 12). Diferente de actualDeliveryDate (entrega ao cliente):
  // o Habite-se costuma vir antes e é o marco jurídico/contratual da troca
  // de índice, não a data em que o cliente recebe as chaves.
  habiteSeDate DateTime?

  // Regra de correção pós-Habite-se — configurável por empreendimento (não
  // por contrato individual, PRD seção 12: "cada empreendimento... regra
  // própria"). A regra de obra (pré-Habite-se) continua no Contract, já
  // que pode variar por tabela de vendas/negociação; a de pós-entrega é a
  // mesma para todos os contratos do empreendimento.
  postHabiteSeIndexRuleId            String?      @db.Uuid
  postHabiteSeMonthlyInterestPercent Decimal?     @db.Decimal(5, 2)
  postHabiteSeInterestType           InterestType @default(COMPOUND)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spe                            SpecialPurposeEntity            @relation(fields: [speId], references: [id], onDelete: Restrict)
  postHabiteSeIndexRule          IndexRule?                      @relation(fields: [postHabiteSeIndexRuleId], references: [id], onDelete: SetNull)
  buildings                      Building[]
  units                          Unit[]
  accessGrants                   AccessGrant[]
  developmentEvents              DevelopmentEvent[]
  salesTables                    SalesTable[]
  proposals                      Proposal[]
  sales                          Sale[]
  contracts                      Contract[]
  costCenters                    CostCenter[]
  payables                       Payable[]
  exchangeContracts              ExchangeContract[]
  reservationRule                ReservationRule?
  proposalEvaluationRule         ProposalEvaluationRule?
  documentTemplates              DocumentTemplateDevelopment[]
  commissionReleaseRule          CommissionReleaseRule?
  distratoRule                   DistratoRule?
  collectionRule                 CollectionRule?
  renegotiationRule              RenegotiationRule?
  payableAllocations             PayableAllocation[]
  allocationTemplateDestinations AllocationTemplateDestination[]
  receivables                    Receivable[]

  @@index([organizationId])
  @@index([speId])
  @@map("developments")
}

/// Torre ou bloco de um empreendimento vertical. Não se aplica a loteamentos.
model Building {
  id            String   @id @default(uuid()) @db.Uuid
  developmentId String   @db.Uuid
  name          String // ex.: "Torre A"
  createdAt     DateTime @default(now())

  development Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  floors      Floor[]
  units       Unit[]

  @@unique([developmentId, name])
  @@map("buildings")
}

/// Pavimento dentro de uma torre/bloco.
model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @db.Uuid
  level      Int // andar (pode ser negativo p/ subsolo)
  label      String? // ex.: "Térreo", "Cobertura"
  createdAt  DateTime @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units    Unit[]

  @@unique([buildingId, level])
  @@map("floors")
}

enum UnitType {
  APARTMENT
  COMMERCIAL_ROOM
  STORE
  LOT
  PARKING_SPACE
  STORAGE_UNIT
  BOX
  OTHER
}

/// Status comercial da unidade — cobre desde a Fase 2 (cadastro) até o funil
/// completo (Fases 3-9), para que o enum não precise mudar quando essas fases
/// forem implementadas. Cor/ordem de exibição ficam em Setting (Fase 3).
enum UnitStatus {
  AVAILABLE
  IN_SERVICE // em atendimento
  RESERVED
  PROPOSAL_UNDER_REVIEW
  PROPOSAL_APPROVED
  CONTRACT_IN_PROGRESS
  AWAITING_SIGNATURE
  SOLD
  BLOCKED
  EXCHANGE // permuta
  DEVELOPER_UNIT
  INVESTOR_UNIT
  CANCELLED // distratada
  UNAVAILABLE
}

/// Unidade sellable — cobre tanto unidades principais (apartamento, sala, loja,
/// lote) quanto acessórias (vaga, escaninho, depósito, box), diferenciadas por
/// isAccessory. Campos específicos de edifício vertical e de loteamento
/// convivem na mesma tabela (nullable), já que nunca se aplicam ao mesmo tempo.
model Unit {
  id            String  @id @default(uuid()) @db.Uuid
  developmentId String  @db.Uuid
  buildingId    String? @db.Uuid
  floorId       String? @db.Uuid

  unitType    UnitType
  isAccessory Boolean    @default(false)
  number      String // identificador da unidade (ex.: "1201", "Lote 45")
  status      UnitStatus @default(AVAILABLE)

  // Campos de edifício vertical
  bedrooms       Int?
  suites         Int?
  privateArea    Decimal? @db.Decimal(12, 2)
  commonArea     Decimal? @db.Decimal(12, 2)
  totalArea      Decimal? @db.Decimal(12, 2)
  idealFraction  Decimal? @db.Decimal(12, 6)
  position       String? // ex.: "Nascente"
  sunOrientation String?

  // Campos de condomínio de lotes
  block                    String? // quadra
  lotArea                  Decimal? @db.Decimal(12, 2)
  frontage                 Decimal? @db.Decimal(12, 2) // testada
  depth                    Decimal? @db.Decimal(12, 2) // profundidade
  buildableArea            Decimal? @db.Decimal(12, 2)
  constructionRestrictions String?
  topography               String?
  locationInCondo          String?
  mapCoordinates           String?

  // Comuns
  registrationNumber String? // matrícula
  hasOwnRegistration Boolean  @default(true)
  referenceValue     Decimal? @db.Decimal(14, 2)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Destaque de permuta física (docs/ESPEC_PERMUTANTES.md, Parte 2.1) — nulo
  // = unidade da SPE. Setado a partir do espelho de vendas, só a partir de
  // AVAILABLE.
  exchangeContractId String? @db.Uuid

  development      Development       @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  building         Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor            Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  exchangeContract ExchangeContract? @relation(fields: [exchangeContractId], references: [id])

  statusHistory    UnitStatusHistory[]
  linksAsPrincipal UnitLink[]          @relation("UnitLinkPrincipal")
  linksAsAccessory UnitLink[]          @relation("UnitLinkAccessory")

  salesTableEntries SalesTableUnit[]
  reservations      Reservation[]
  waitlistEntries   ReservationWaitlistEntry[]
  proposals         Proposal[]
  sale              Sale?
  contract          Contract?

  @@unique([developmentId, number])
  @@index([developmentId, status])
  @@map("units")
}

/// Histórico de mudança de status da unidade (PRD seção 4: "Cada status deve
/// ter uma cor e um histórico").
model UnitStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  unitId          String      @db.Uuid
  fromStatus      UnitStatus?
  toStatus        UnitStatus
  changedByUserId String?     @db.Uuid
  reason          String?
  occurredAt      DateTime    @default(now())

  unit      Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedBy User? @relation("UnitStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([unitId])
  @@map("unit_status_history")
}

enum UnitLinkType {
  MANDATORY // obrigatoriamente vinculada
  OPTIONAL
  SEPARATE_SALE // vendida separadamente
}

enum UnitLinkPricing {
  INCLUDED_IN_PRICE // incorporada ao preço da unidade principal
  SEPARATE_INSTRUMENT // contratada em instrumento separado
}

/// Vínculo entre uma unidade principal e uma unidade acessória (vaga,
/// escaninho, depósito...). Ex.: Apto 1201 vinculado às vagas G45/G46 e ao
/// escaninho E12 (doc de arquitetura seção 3).
model UnitLink {
  id              String          @id @default(uuid()) @db.Uuid
  principalUnitId String          @db.Uuid
  accessoryUnitId String          @db.Uuid
  linkType        UnitLinkType    @default(MANDATORY)
  pricing         UnitLinkPricing @default(INCLUDED_IN_PRICE)
  createdAt       DateTime        @default(now())

  principalUnit Unit @relation("UnitLinkPrincipal", fields: [principalUnitId], references: [id], onDelete: Cascade)
  accessoryUnit Unit @relation("UnitLinkAccessory", fields: [accessoryUnitId], references: [id], onDelete: Cascade)

  @@unique([principalUnitId, accessoryUnitId])
  @@map("unit_links")
}

// ============================================================================
// FASE 4-7 — TABELAS DE VENDA, CRM COMERCIAL, PROPOSTAS E VENDAS
// ============================================================================
//
// Escopo: Sprint 3-4 do plano (docs/SPRINTS_INCORPORA.md) — da tabela de
// vendas até a venda fechada com comissão. Contratos/minuta (Sprint 5) e
// carteira/indexadores de verdade (Sprint 6-7) ainda não existem; o fluxo de
// pagamento da proposta fica congelado em Proposal.paymentFlow (JSON) como
// simulação, e a carteira real (Installment/IndexRule) é criada só quando
// esse motor for desenhado.

enum CustomerType {
  INDIVIDUAL // pessoa física
  COMPANY // pessoa jurídica
}

/// Comprador (pessoa física ou jurídica). Checklist completo de documentos
/// pessoais/cônjuge (PRD seção 8) fica para quando o módulo de contratos
/// precisar deles — aqui ficam os dados mínimos para reserva/proposta/venda.
model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  type           CustomerType @default(INDIVIDUAL)
  name           String
  document       String // CPF ou CNPJ, validado por dígito verificador em novos cadastros/edições
  email          String?
  phone          String?
  address        String? // legado — cadastros anteriores ao endereço estruturado (ver campos abaixo). Não é mais escrito por cadastros novos, mas nunca apagado.
  zipCode        String? // CEP, autocompleta os campos abaixo via ViaCEP
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?      @db.VarChar(2)
  // Qualificação civil — só se aplica a CustomerType.INDIVIDUAL, mas fica
  // nullable pra CNPJ também (sem constraint condicional). Necessário pro
  // quadro-resumo/qualificação das partes do motor de templates (Fase A,
  // Parte 1) — sem esses campos, {{cliente.estado_civil}} etc. nunca resolvem.
  maritalStatus  String?
  nationality    String?
  profession     String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization                       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations                       Reservation[]
  waitlistEntries                    ReservationWaitlistEntry[]
  proposals                          Proposal[]
  sales                              Sale[]
  contracts                          Contract[]
  contacts                           CustomerContact[]
  contractAssignmentsAsPreviousOwner ContractAssignment[]       @relation("ContractAssignmentPreviousCustomer")
  contractAssignmentsAsNewOwner      ContractAssignment[]       @relation("ContractAssignmentNewCustomer")
  supplierAsRefundPayee              Supplier?
  collectionContactLogs              CollectionContactLog[]
  receivables                        Receivable[]

  @@unique([organizationId, document])
  @@map("customers")
}

/// Contato adicional de um cliente (além dos dados principais) — pensado
/// para quem recebe documentos financeiros ou vai acessar o Portal do
/// Cliente (Fase 2), que pode não ser a mesma pessoa do cadastro principal.
model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  name       String
  role       String? // cargo/relação com o cliente, ex.: "Cônjuge", "Financeiro"
  email      String?
  phone      String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

/// Imobiliária parceira.
model RealEstateAgency {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  document       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brokers         Broker[]
  reservations    Reservation[]
  waitlistEntries ReservationWaitlistEntry[]
  proposals       Proposal[]
  supplier        Supplier?

  @@map("real_estate_agencies")
}

/// Corretor de vendas, opcionalmente vinculado a uma imobiliária.
model Broker {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  agencyId       String?  @db.Uuid
  name           String
  document       String?
  email          String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agency          RealEstateAgency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  reservations    Reservation[]
  waitlistEntries ReservationWaitlistEntry[]
  proposals       Proposal[]
  supplier        Supplier?

  @@map("brokers")
}

/// Tabela de vendas de um empreendimento (PRD seção 5). Um empreendimento
/// pode ter várias tabelas simultâneas (lançamento, promocional, investidor...).
enum DownPaymentDestination {
  SPE_ACCOUNT // entrada compõe o fluxo normal da carteira
  BROKER_COMMISSION // a entrada É a comissão — paga direto ao corretor/imobiliária
}

model SalesTable {
  id                                String                 @id @default(uuid()) @db.Uuid
  developmentId                     String                 @db.Uuid
  name                              String
  startDate                         DateTime               @default(now())
  validUntil                        DateTime?
  downPaymentPercent                Decimal?               @db.Decimal(5, 2) // % de entrada
  monthlyInstallments               Int? // quantidade de parcelas mensais
  keysInstallmentPercent            Decimal?               @db.Decimal(5, 2) // % na parcela de chaves
  maxDiscountPercent                Decimal?               @db.Decimal(5, 2)
  commissionPercent                 Decimal?               @db.Decimal(5, 2)
  indexCode                         String? // ex.: "INCC", "IPCA", "FIXED" — motor real na Fase 10
  // Destino do valor de entrada (docs/ESPEC_MODULO_COMERCIAL.md, Parte 4.2) —
  // sobrescrevível por venda em Sale.downPaymentDestinationOverride.
  downPaymentDestination            DownPaymentDestination @default(SPE_ACCOUNT)
  // Regra de correção da fase de obra (pré-Habite-se) usada só pra projetar o
  // fluxo NOMINAL da proposta antes do desconto a valor presente (Parte 5.2)
  // — o Contract real ainda define a sua própria regra em separado
  // (src/server/receivables.ts:setContractCorrectionRule), pois só existe
  // depois que a venda é convertida. Nula = sem projeção de índice na fase
  // de obra (só juros, se houver).
  preHabiteSeIndexRuleId            String?                @db.Uuid
  preHabiteSeMonthlyInterestPercent Decimal?               @db.Decimal(5, 2)
  preHabiteSeInterestType           InterestType           @default(COMPOUND)
  isActive                          Boolean                @default(true)
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt

  development          Development      @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  preHabiteSeIndexRule IndexRule?       @relation(fields: [preHabiteSeIndexRuleId], references: [id], onDelete: SetNull)
  units                SalesTableUnit[]
  proposals            Proposal[]

  @@index([developmentId])
  @@map("sales_tables")
}

/// Preço de uma unidade dentro de uma tabela de vendas específica.
model SalesTableUnit {
  id           String   @id @default(uuid()) @db.Uuid
  salesTableId String   @db.Uuid
  unitId       String   @db.Uuid
  price        Decimal  @db.Decimal(14, 2)
  pricePerSqm  Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  salesTable SalesTable @relation(fields: [salesTableId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([salesTableId, unitId])
  @@map("sales_table_units")
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED // virou proposta
  CANCELLED
}

/// Reserva de unidade — objeto próprio, não apenas um status (PRD seção 6).
model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  unitId          String            @db.Uuid
  customerId      String            @db.Uuid
  brokerId        String?           @db.Uuid
  agencyId        String?           @db.Uuid
  salesTableId    String?           @db.Uuid
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime
  reason          String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  // Regras de reserva (docs/ESPEC_MODULO_COMERCIAL.md, Parte 2) — renovação
  // com teto configurável por empreendimento, e marca de reserva nascida da
  // fila de espera (janela de prioridade menor, não uma reserva comum).
  renewalCount    Int               @default(0)
  fromWaitlist    Boolean           @default(false)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit            Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  customer        Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  broker          Broker?                    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  agency          RealEstateAgency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  waitlistEntries ReservationWaitlistEntry[]
  sales           Sale[]

  @@index([organizationId, status])
  @@index([unitId])
  @@map("reservations")
}

/// Regra de reserva — geral (organização, `developmentId` nulo) OU por
/// empreendimento (docs/ESPEC_NAVEGACAO_PERFIS_RBAC.md, Parte 1.3). Nula/
/// ausente até a TSH configurar; nesse caso os defaults sugeridos pela
/// especificação valem (ver DEFAULT_RESERVATION_RULE em
/// src/server/reservation-rules.ts). Mesmo padrão de todas as 6 regras
/// parametrizáveis — ver comentário completo em `DistratoRule`.
model ReservationRule {
  id                             String   @id @default(uuid()) @db.Uuid
  organizationId                 String   @db.Uuid
  developmentId                  String?  @unique @db.Uuid
  validityHours                  Int      @default(48)
  maxActiveReservationsPerBroker Int? // nulo = sem limite
  waitlistEnabled                Boolean  @default(true)
  waitlistPriorityHours          Int      @default(24)
  renewalAllowed                 Boolean  @default(true)
  maxRenewals                    Int      @default(1)
  requiresApprovalForRenewal     Boolean  @default(true)
  requireIdentifiedCustomer      Boolean  @default(true)
  // Papéis com permissão pra reservar neste empreendimento, além da regra
  // geral de permissão (reservation.CREATE) — vazio = sem restrição extra,
  // vale só a permissão. Guarda o nome do papel (Role.name), não o id.
  allowedReserverRoles           String[] @default([])
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@map("reservation_rules")
}

enum RatePeriod {
  MONTHLY // % a.m.
  YEARLY // % a.a.
}

/// Regras do motor de avaliação automática de propostas — geral (organização)
/// OU por empreendimento (docs/ESPEC_MODULO_COMERCIAL.md, Parte 5.2;
/// docs/ESPEC_NAVEGACAO_PERFIS_RBAC.md, Parte 1.3). Defaults sugeridos quando
/// não configurada — ver DEFAULT_PROPOSAL_EVALUATION_RULE em
/// src/server/proposal-evaluation-rules.ts. Mesmo padrão das 6 regras
/// parametrizáveis — ver comentário completo em `DistratoRule`.
model ProposalEvaluationRule {
  id                      String          @id @default(uuid()) @db.Uuid
  organizationId          String          @db.Uuid
  developmentId           String?         @unique @db.Uuid
  allowOffTable           Boolean         @default(true)
  discountRatePercent     Decimal         @default(1) @db.Decimal(6, 3) // taxa de desconto (TMA) pro VPL
  discountRatePeriod      RatePeriod      @default(MONTHLY)
  vplTolerancePercent     Decimal         @default(3) @db.Decimal(6, 3) // aprova sozinha até este deságio de VPL
  vplAnalysisLimitPercent Decimal         @default(10) @db.Decimal(6, 3) // acima disso, reprovada automaticamente
  minDownPaymentPercent   Decimal         @default(10) @db.Decimal(5, 2) // limite duro
  maxTermMonths           Int             @default(120) // limite duro
  maxPostKeysPercent      Decimal         @default(30) @db.Decimal(5, 2) // limite duro
  // Papéis que analisam propostas em "aguardando análise" — substitui a
  // faixa fixa por % de desconto que existia antes deste módulo.
  analysisApprovalLevels  ApprovalLevel[] @default([SALES_MANAGER])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@map("proposal_evaluation_rules")
}

enum ReservationWaitlistStatus {
  WAITING
  CONVERTED // promovida a reserva de verdade quando a unidade foi liberada
  CANCELLED
}

/// Fila de espera por unidade reservada (Parte 2) — FIFO por createdAt.
/// Quando a reserva ativa da unidade expira ou é cancelada, o primeiro da
/// fila é promovido automaticamente a uma reserva real, com prazo de
/// prioridade mais curto (`ReservationRule.waitlistPriorityHours`) em vez do
/// prazo normal.
model ReservationWaitlistEntry {
  id                     String                    @id @default(uuid()) @db.Uuid
  unitId                 String                    @db.Uuid
  customerId             String                    @db.Uuid
  brokerId               String?                   @db.Uuid
  agencyId               String?                   @db.Uuid
  status                 ReservationWaitlistStatus @default(WAITING)
  createdAt              DateTime                  @default(now())
  convertedAt            DateTime?
  convertedReservationId String?                   @unique @db.Uuid
  cancelledAt            DateTime?

  unit                 Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  broker               Broker?           @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  agency               RealEstateAgency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  convertedReservation Reservation?      @relation(fields: [convertedReservationId], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@map("reservation_waitlist_entries")
}

enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED // virou venda
  CANCELLED
}

enum ApprovalLevel {
  COMMERCIAL
  SALES_MANAGER
  DIRECTOR
  FINANCIAL
  LEGAL
  PARTNERS
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum ProposalEvaluationStatus {
  APPROVED_AUTO // dentro da tolerância de VPL — vira proposta formal sem intervenção humana
  PENDING_ANALYSIS // fora da tolerância, dentro do limite de deságio — vai pro módulo de aprovação
  REJECTED_AUTO // violou limite duro ou deságio além do limite — recusada na hora
}

/// Proposta comercial (PRD seção 7). Versionada via parentProposalId — cada
/// alteração relevante gera uma nova versão em vez de sobrescrever a anterior.
model Proposal {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String                    @db.Uuid
  developmentId       String                    @db.Uuid
  unitId              String                    @db.Uuid
  customerId          String                    @db.Uuid
  salesTableId        String?                   @db.Uuid
  brokerId            String?                   @db.Uuid
  agencyId            String?                   @db.Uuid
  parentProposalId    String?                   @db.Uuid
  version             Int                       @default(1)
  listPrice           Decimal                   @db.Decimal(14, 2)
  discountPercent     Decimal                   @default(0) @db.Decimal(5, 2)
  salePrice           Decimal                   @db.Decimal(14, 2)
  commissionPercent   Decimal?                  @db.Decimal(5, 2)
  paymentFlow         Json? // snapshot do simulador (entrada/mensais/chaves) — o fluxo da TABELA PADRÃO
  // Contra-proposta de fluxo (Parte 5.1) — nulo quando a proposta segue a
  // tabela padrão sem desvio (paymentFlow == proposedPaymentFlow nesse caso).
  proposedPaymentFlow Json?
  // Módulo de avaliação automática (Parte 5.2) — a análise numérica que
  // acompanha a proposta pro gestor decidir com dado, registrada em toda
  // proposta submetida (auditoria).
  evaluationStatus    ProposalEvaluationStatus?
  npvStandard         Decimal?                  @db.Decimal(14, 2)
  npvProposed         Decimal?                  @db.Decimal(14, 2)
  npvDeviationPercent Decimal?                  @db.Decimal(7, 3)
  evaluationReason    String?
  evaluationChecks    Json?
  status              ProposalStatus            @default(DRAFT)
  notes               String?
  createdByUserId     String?                   @db.Uuid
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development    Development        @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  unit           Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesTable     SalesTable?        @relation(fields: [salesTableId], references: [id], onDelete: SetNull)
  broker         Broker?            @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  agency         RealEstateAgency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  parentProposal Proposal?          @relation("ProposalVersion", fields: [parentProposalId], references: [id], onDelete: SetNull)
  childVersions  Proposal[]         @relation("ProposalVersion")
  approvals      ProposalApproval[]
  sale           Sale?

  @@index([organizationId, status])
  @@index([unitId])
  @@map("proposals")
}

/// Uma etapa de alçada de aprovação da proposta (PRD seção 7: comercial,
/// gerente, diretor, financeiro, jurídico, sócios).
model ProposalApproval {
  id             String           @id @default(uuid()) @db.Uuid
  proposalId     String           @db.Uuid
  level          ApprovalLevel
  approverUserId String?          @db.Uuid
  decision       ApprovalDecision @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, level])
  @@map("proposal_approvals")
}

enum SaleStatus {
  ACTIVE
  CANCELLED // distrato — tratamento completo na Fase 15
}

/// Venda — criada a partir da conversão de uma proposta aprovada (PRD seção 8).
model Sale {
  id                             String                  @id @default(uuid()) @db.Uuid
  organizationId                 String                  @db.Uuid
  developmentId                  String                  @db.Uuid
  unitId                         String                  @unique @db.Uuid
  proposalId                     String                  @unique @db.Uuid
  customerId                     String                  @db.Uuid
  // Reserva ativa no momento da conversão, quando havia uma — link explícito
  // pra montar a linha do tempo da venda (Fase A, Parte 3.2) sem precisar
  // adivinhar por unitId+customerId+status. Nulo em vendas sem reserva prévia
  // (ou vendas anteriores à existência deste campo).
  reservationId                  String?                 @db.Uuid
  // Número sequencial da venda por organização (Fase A, Parte 3.1 — coluna
  // "nº da venda" da lista), independente do número do contrato (que só
  // existe depois que a minuta é gerada).
  saleNumber                     String
  saleDate                       DateTime                @default(now())
  salePrice                      Decimal                 @db.Decimal(14, 2)
  status                         SaleStatus              @default(ACTIVE)
  // Sobrescreve o destino da entrada definido na tabela de vendas (Parte
  // 4.2) — nulo = usa o da tabela. Alteração gated por permissão na action.
  downPaymentDestinationOverride DownPaymentDestination?
  createdAt                      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  proposal     Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  commissionSplits CommissionSplit[]
  contract         Contract?

  @@unique([organizationId, saleNumber])
  @@map("sales")
}

enum CommissionBeneficiaryType {
  BROKER
  AGENCY
  COORDINATOR
  MANAGER
  CAMPAIGN
}

enum CommissionStatus {
  PENDING // "A liberar" — ainda não bateu o gatilho da regra de liberação
  RELEASED // "Liberada" — pronta pra ser lançada/paga em Contas a pagar
  INVOICED
  PAID // "Paga" — Payable vinculado foi pago (mesma ação usada por qualquer conta a pagar)
  CANCELLED // estorno (distrato — Fase A etapa 6, ainda não construída)
}

/// Split de comissão da venda (PRD seção 10) — pode ser dividida entre
/// corretor, imobiliária, coordenador, gerente e campanha. Ciclo de
/// liberação/pagamento (Fase A, Parte 4.1): PENDING -> RELEASED (regra
/// configurável por empreendimento, ver CommissionReleaseRule) -> PAID
/// (via o Payable vinculado sendo pago pelo fluxo normal de Contas a pagar
/// — não existe uma ação de "pagar comissão" separada, spec 4.2: "sem duplo
/// lançamento manual").
model CommissionSplit {
  id              String                    @id @default(uuid()) @db.Uuid
  saleId          String                    @db.Uuid
  beneficiaryType CommissionBeneficiaryType
  brokerId        String?                   @db.Uuid
  agencyId        String?                   @db.Uuid
  label           String? // nome do coordenador/gerente/campanha, quando não for broker/agency
  percent         Decimal                   @db.Decimal(5, 2)
  value           Decimal                   @db.Decimal(14, 2)
  dueDate         DateTime?
  status          CommissionStatus          @default(PENDING)
  releasedAt      DateTime?
  paidAt          DateTime?
  payableId       String?                   @unique @db.Uuid
  createdAt       DateTime                  @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payable Payable? @relation(fields: [payableId], references: [id], onDelete: SetNull)

  @@map("commission_splits")
}

enum CommissionReleaseTrigger {
  ON_CONTRACT_SIGNATURE // libera tudo na assinatura do contrato
  ON_DOWN_PAYMENT_RECEIVED // libera quando a parcela de entrada é recebida
  ON_INSTALLMENTS_PAID_PERCENT // libera quando X% das parcelas da carteira estiverem pagas
}

/// Regra de liberação de comissão — geral (organização) OU por empreendimento
/// (Fase A, Parte 4.1 — "regra de liberação configurável";
/// docs/ESPEC_NAVEGACAO_PERFIS_RBAC.md, Parte 1.3). Mesmo padrão das 6 regras
/// parametrizáveis — ver comentário completo em `DistratoRule`.
model CommissionReleaseRule {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @db.Uuid
  developmentId           String?                  @unique @db.Uuid
  trigger                 CommissionReleaseTrigger @default(ON_CONTRACT_SIGNATURE)
  installmentsPaidPercent Int                      @default(50) // só usado quando trigger = ON_INSTALLMENTS_PAID_PERCENT
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@map("commission_release_rules")
}

/// Regra de distrato — geral (organização, `developmentId` nulo) OU por
/// empreendimento (Fase A, Parte 2.4 — Lei 13.786/18: retenção configurável,
/// até 25% do valor pago, ou até 50% com patrimônio de afetação instituído;
/// docs/ESPEC_NAVEGACAO_PERFIS_RBAC.md, Parte 1.3 — consistência geral ×
/// empreendimento). No máximo uma linha geral por organização e uma por
/// empreendimento — garantido em `upsertDistratoRule`, não no schema (índice
/// parcial exigiria SQL fora do que o Prisma schema expressa declarativamente;
/// mesmo padrão de "validação na camada de serviço" já usado no resto do
/// projeto). O teto legal é validado no momento de salvar a regra (contra
/// `Development.hasPropertyAffectation`), não travado no schema — o negócio
/// pode mudar de patrimônio de afetação.
model DistratoRule {
  id                          String   @id @default(uuid()) @db.Uuid
  organizationId              String   @db.Uuid
  developmentId               String?  @unique @db.Uuid
  retentionPercent            Decimal  @default(25) @db.Decimal(5, 2)
  reverseCommissionOnDistrato Boolean  @default(true) // estorna (CANCELLED) splits ainda não pagos ao distratar
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@map("distrato_rules")
}

/// Régua de cobrança — geral (organização) OU por empreendimento (Fase B,
/// Parte 3.2; docs/ESPEC_NAVEGACAO_PERFIS_RBAC.md, Parte 1.3). Etapa
/// assistida (não automática): as `CollectionRuleStep` só descrevem
/// prazo × ação sugerida; quem "avança" na régua é calculado na hora, a
/// partir dos dias em atraso — não existe um campo persistido de "etapa
/// atual" em lugar nenhum. Quando a automação da Fase 2 chegar (e-mail/
/// WhatsApp disparado sozinho), a mesma régua configurada aqui vira a fonte
/// dos gatilhos — por isso as etapas já ficam com posição/prazo/ação como
/// campos de primeira classe, não texto livre. Mesmo padrão das 6 regras
/// parametrizáveis — ver comentário completo em `DistratoRule`.
model CollectionRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  developmentId  String?  @unique @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development?         @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  steps        CollectionRuleStep[]

  @@map("collection_rules")
}

/// Uma etapa da régua — `offsetDays` é relativo ao vencimento da parcela
/// (negativo = antes de vencer, ex.: -5 = "D-5"; positivo = dias em
/// atraso, ex.: 15 = "D+15"). `sequence` define a ordem de exibição/
/// avaliação (sempre crescente com `offsetDays` na prática, mas guardado
/// à parte pra não depender de reordenar por valor quando o usuário edita).
model CollectionRuleStep {
  id               String @id @default(uuid()) @db.Uuid
  collectionRuleId String @db.Uuid
  sequence         Int
  offsetDays       Int
  actionLabel      String

  collectionRule CollectionRule @relation(fields: [collectionRuleId], references: [id], onDelete: Cascade)

  @@unique([collectionRuleId, sequence])
  @@map("collection_rule_steps")
}

/// Histórico de cobrança (Fase B, Parte 3.2) — registro manual de contato
/// feito com o cliente ("o usuário registra o contato feito: data, canal,
/// resumo, próximo passo"). Por CLIENTE (não por contrato/parcela) — a
/// régua e o painel de cobrança são pensados no nível do cliente ("em qual
/// etapa da régua ele está"), e o mesmo histórico aparece tanto no painel
/// de cobrança quanto numa aba própria do extrato do cliente (Fase B,
/// Parte 1 + 3.2).
model CollectionContactLog {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  customerId      String   @db.Uuid
  occurredAt      DateTime
  channel         String // texto livre por ora: "Ligação", "WhatsApp", "E-mail", "Presencial"...
  summary         String
  nextStepNote    String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("collection_contact_logs")
}

/// Regra de renegociação de parcelas — geral (organização) OU por
/// empreendimento (Fase B, Parte 2.2, passo 4 — "mesma infraestrutura de
/// aprovação existente"; docs/ESPEC_NAVEGACAO_PERFIS_RBAC.md, Parte 1.3).
/// Mesmo padrão de `ProposalEvaluationRule`: uma faixa de tolerância sem
/// alçada (`maxDiscountOnChargesPercent`) e um teto rígido de prazo
/// (`maxTermMonths`, sem bypass por alçada — acima disso o acordo é
/// rejeitado, não aprovado por alguém). Acima da tolerância de desconto,
/// o acordo precisa de aprovação nos níveis listados em `approvalLevels`
/// (mesmo `ApprovalLevel`/`ApprovalDecision` já usados nas propostas).
model RenegotiationRule {
  id                          String          @id @default(uuid()) @db.Uuid
  organizationId              String          @db.Uuid
  developmentId               String?         @unique @db.Uuid
  maxDiscountOnChargesPercent Decimal         @default(20) @db.Decimal(5, 2)
  maxTermMonths               Int             @default(24)
  brokenDealGraceDays         Int             @default(15)
  reactivateOriginalOnBreak   Boolean         @default(false)
  approvalLevels              ApprovalLevel[] @default([SALES_MANAGER])
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@map("renegotiation_rules")
}

enum RenegotiationAgreementStatus {
  DRAFT // criado, sem aprovação pendente (dentro da tolerância) ou já aprovado — assinável
  PENDING_APPROVAL // desconto acima da tolerância, aguardando alçada
  SIGNED // efeitos aplicados: parcelas originais viraram Renegociada, novas parcelas criadas
  BROKEN // uma parcela do acordo venceu sem pagamento além do prazo de tolerância configurado
  REJECTED // alguma etapa de alçada reprovou — terminal, é preciso criar um novo acordo
}

/// Acordo de renegociação de parcelas (Fase B, Parte 2) — diferente do
/// aditivo de renegociação de fluxo (Fase A, `ContractAmendment`, que
/// redesenha o fluxo FUTURO inteiro): aqui o acordo consolida dívida
/// vencida/a vencer JÁ EXISTENTE (parcelas selecionadas pelo usuário no
/// extrato), com desconto sobre os encargos (multa+mora — nunca sobre o
/// principal corrigido) e reparcelamento. `consolidatedPrincipal`/
/// `consolidatedCharges` são o snapshot calculado (ao vivo, sem persistir
/// `FinancialCalculation`) na `agreementDate` — a mesma lógica de
/// `getInstallmentLivePosition` das etapas 1 e 2. Ao assinar: parcelas de
/// origem viram CANCELLED (nunca apagadas — a UI mostra como
/// "Renegociada", com link pra este acordo) e as novas nascem vinculadas
/// por `destinationAgreementId`, numeração de `Installment.sequence`
/// continuando do maior já usado no contrato (mesmo padrão da etapa 4 da
/// Fase A).
model RenegotiationAgreement {
  id                     String                       @id @default(uuid()) @db.Uuid
  organizationId         String                       @db.Uuid
  contractId             String                       @db.Uuid
  sequenceNumber         Int
  agreementNumber        String // "CT-2026-0001-RN01"
  status                 RenegotiationAgreementStatus @default(DRAFT)
  agreementDate          DateTime
  consolidatedPrincipal  Decimal                      @db.Decimal(14, 2)
  consolidatedCharges    Decimal                      @db.Decimal(14, 2)
  chargesDiscountPercent Decimal                      @db.Decimal(5, 2)
  chargesDiscountAmount  Decimal                      @db.Decimal(14, 2)
  downPayment            Decimal?                     @db.Decimal(14, 2)
  finalValue             Decimal                      @db.Decimal(14, 2)
  applyFutureCorrection  Boolean                      @default(true)
  proposedPaymentFlow    Json?
  reason                 String?
  brokenAt               DateTime?
  reactivatedOriginal    Boolean                      @default(false)
  signedAt               DateTime?
  signedDocumentPath     String?
  createdByUserId        String?                      @db.Uuid
  createdAt              DateTime                     @default(now())

  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract                Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approvals               RenegotiationApproval[]
  originInstallments      Installment[]           @relation("RenegotiationOrigin")
  destinationInstallments Installment[]           @relation("RenegotiationDestination")

  @@unique([contractId, sequenceNumber])
  @@unique([organizationId, agreementNumber])
  @@map("renegotiation_agreements")
}

/// Etapa de alçada de um acordo de renegociação — mesmo formato de
/// `ProposalApproval`, reaproveitando `ApprovalLevel`/`ApprovalDecision`.
model RenegotiationApproval {
  id             String           @id @default(uuid()) @db.Uuid
  agreementId    String           @db.Uuid
  level          ApprovalLevel
  approverUserId String?          @db.Uuid
  decision       ApprovalDecision @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  agreement RenegotiationAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, level])
  @@map("renegotiation_approvals")
}

// ============================================================================
// FASE 8 — CONTRATOS E CARTEIRA INICIAL
// ============================================================================
//
// Escopo: Sprint 5 do plano (docs/SPRINTS_INCORPORA.md) — dados contratuais,
// geração de minuta (renderizada sob demanda, sem motor de template ainda),
// upload de contrato assinado (via Document, categoria CONTRACT — sem bucket
// de Storage configurado ainda, então o campo guarda uma referência/URL
// informada manualmente) e criação automática da carteira ao confirmar a
// assinatura. O motor de indexadores e correção monetária de verdade
// (IndexRule/IndexValue/FinancialCalculation) é da Fase 10 — por ora a
// parcela nasce com o valor nominal do fluxo simulado na proposta.

enum ContractStatus {
  DRAFT // minuta gerada, ainda não enviada para assinatura
  AWAITING_SIGNATURE
  SIGNED
  CANCELLED
}

/// Contrato de compra e venda gerado a partir de uma venda (PRD seção 9).
model Contract {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  developmentId      String         @db.Uuid
  unitId             String         @unique @db.Uuid
  saleId             String         @unique @db.Uuid
  customerId         String         @db.Uuid
  contractNumber     String
  status             ContractStatus @default(DRAFT)
  issuedAt           DateTime       @default(now())
  signedAt           DateTime?
  signedDocumentPath String? // caminho no bucket privado "contracts" do Supabase Storage (não é uma URL pública — acesso via URL assinada de curto prazo)
  notes              String?

  // Regra de correção da fase de obra (pré-Habite-se), por contrato — pode
  // variar por tabela/negociação. A fase pós-Habite-se usa a regra
  // cadastrada no Development (postHabiteSeIndexRuleId e afins), a mesma
  // para todos os contratos daquele empreendimento (PRD seção 12).
  // Multa/mora por atraso valem em qualquer fase, por isso ficam aqui.
  indexRuleId                       String?      @db.Uuid
  monthlyInterestPercent            Decimal?     @db.Decimal(5, 2) // juros contratuais somados ao índice, fase de obra
  interestType                      InterestType @default(COMPOUND)
  latePaymentFinePercent            Decimal      @default(2) @db.Decimal(5, 2)
  latePaymentMonthlyInterestPercent Decimal      @default(1) @db.Decimal(5, 2)

  // Excedente da entrada sobre a comissão total, quando a entrada É a
  // comissão do corretor (Parte 4.2) e é maior que o devido — "lançado como
  // crédito à SPE". Só registrado pra visibilidade do Financeiro; não existe
  // mecanismo de cobrança automática contra o corretor (fora do modelo hoje).
  downPaymentCommissionExcess Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  indexRule    IndexRule?   @relation(fields: [indexRuleId], references: [id], onDelete: SetNull)

  portfolio               ReceivablePortfolio?
  amendments              ContractAmendment[]
  assignments             ContractAssignment[]
  distrato                ContractDistrato?
  renegotiationAgreements RenegotiationAgreement[]

  @@unique([organizationId, contractNumber])
  @@map("contracts")
}

enum ContractAmendmentType {
  FLOW_RENEGOTIATION // renegociação de fluxo — reprograma a carteira
  UNIT_CHANGE // alteração de unidade
  TERM_CHANGE // alteração de prazo
  OTHER
}

enum ContractAmendmentStatus {
  DRAFT
  SIGNED
}

/// Aditivo contratual (Fase A, Parte 2.2) — criado a partir do contrato
/// vigente, numeração sequencial vinculada (`CT-2026-0001-AD01`). Só o tipo
/// `FLOW_RENEGOTIATION` tem efeito automático na carteira (reprogramação ao
/// assinar); os demais tipos ficam registrados e documentados, sem side
/// effect estrutural (mudar unidade/prazo de verdade é fora do escopo desta
/// etapa — a spec não detalha esse comportamento).
model ContractAmendment {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @db.Uuid
  contractId          String                  @db.Uuid
  sequenceNumber      Int // 1, 2, 3... por contrato
  amendmentNumber     String // "CT-2026-0001-AD01"
  type                ContractAmendmentType
  status              ContractAmendmentStatus @default(DRAFT)
  proposedPaymentFlow Json? // só quando type = FLOW_RENEGOTIATION — snapshot do novo fluxo (mesmo shape do PaymentFlowResult)
  notes               String?
  signedAt            DateTime?
  signedDocumentPath  String? // caminho no bucket "contracts" do Supabase Storage, mesmo padrão do Contract
  createdByUserId     String?                 @db.Uuid
  createdAt           DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, sequenceNumber])
  @@unique([organizationId, amendmentNumber])
  @@map("contract_amendments")
}

enum ContractAssignmentStatus {
  DRAFT
  SIGNED
}

/// Cessão de direitos (Fase A, Parte 2.3) — transferência da titularidade
/// do contrato vigente pro cliente cessionário. Numeração sequencial
/// vinculada (`CT-2026-0001-CS01`). Ao assinar: `Contract.customerId` passa
/// a apontar pro novo titular (o cedente permanece intacto em
/// `Sale.customerId` — histórico da venda original nunca muda), a carteira
/// não é recriada (as parcelas continuam as mesmas, só o titular do
/// contrato muda a partir da data da cessão), e uma taxa de cessão opcional
/// vira uma parcela nova na carteira existente (não existe um lançamento
/// financeiro avulso genérico no sistema — reaproveita `Installment`).
model ContractAssignment {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @db.Uuid
  contractId         String                   @db.Uuid
  sequenceNumber     Int // 1, 2, 3... por contrato
  assignmentNumber   String // "CT-2026-0001-CS01"
  previousCustomerId String                   @db.Uuid
  newCustomerId      String                   @db.Uuid
  status             ContractAssignmentStatus @default(DRAFT)
  assignmentDate     DateTime // data efetiva da mudança de titularidade / vencimento da taxa
  feeAmount          Decimal?                 @db.Decimal(14, 2)
  notes              String?
  signedAt           DateTime?
  signedDocumentPath String? // caminho no bucket "contracts" do Supabase Storage, mesmo padrão do Contract
  createdByUserId    String?                  @db.Uuid
  createdAt          DateTime                 @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract         Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  previousCustomer Customer     @relation("ContractAssignmentPreviousCustomer", fields: [previousCustomerId], references: [id])
  newCustomer      Customer     @relation("ContractAssignmentNewCustomer", fields: [newCustomerId], references: [id])
  receivable       Receivable?

  @@unique([contractId, sequenceNumber])
  @@unique([organizationId, assignmentNumber])
  @@map("contract_assignments")
}

enum ContractDistratoStatus {
  DRAFT
  SIGNED
}

/// Distrato (Fase A, Parte 2.4 — Lei 13.786/18) — rescisão do contrato com
/// devolução calculada. Só um por contrato (rescindir é terminal — não
/// existe "segundo distrato" do mesmo contrato), por isso `contractId` é
/// 1:1 direto, diferente da numeração sequencial de aditivo/cessão. Os
/// campos numéricos (`totalPaid`/`retentionAmount`/`refundAmount`) guardam
/// um snapshot calculado na criação do rascunho (pra mostrar o demonstrativo
/// antes de assinar) — `signDistrato` RECALCULA na hora de assinar, contra o
/// estado real da carteira naquele momento, e sobrescreve antes de aplicar
/// os efeitos (nunca confia num snapshot que pode ter ficado desatualizado
/// entre o rascunho e a assinatura).
model ContractDistrato {
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationId           String                 @db.Uuid
  contractId               String                 @unique @db.Uuid
  distratoNumber           String // "CT-2026-0001-DT01"
  status                   ContractDistratoStatus @default(DRAFT)
  totalPaid                Decimal                @db.Decimal(14, 2)
  retentionPercent         Decimal                @db.Decimal(5, 2)
  retentionAmount          Decimal                @db.Decimal(14, 2)
  brokerageDeductionAmount Decimal?               @db.Decimal(14, 2)
  occupancyFeeAmount       Decimal?               @db.Decimal(14, 2)
  refundAmount             Decimal                @db.Decimal(14, 2)
  refundDueDate            DateTime
  refundTerms              String? // prazo/forma da devolução, campo livre pro acordo (spec 2.4)
  refundPayableId          String?                @unique @db.Uuid
  reason                   String?
  signedAt                 DateTime?
  signedDocumentPath       String?
  createdByUserId          String?                @db.Uuid
  createdAt                DateTime               @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract      Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  refundPayable Payable?     @relation(fields: [refundPayableId], references: [id], onDelete: SetNull)

  @@unique([organizationId, distratoNumber])
  @@map("contract_distratos")
}

/// Carteira de recebíveis de um contrato — criada automaticamente na
/// confirmação de assinatura, a partir do Proposal.paymentFlow simulado.
/// Motor de indexadores/inadimplência/recebimentos chega na Fase 9-10.
model ReceivablePortfolio {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  contractId     String   @unique @db.Uuid
  totalValue     Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@map("receivable_portfolios")
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/// Parcela da carteira. originalValue nunca muda após criada — é o valor
/// nominal do fluxo simulado na proposta. correctedValue/lastCalculatedAt
/// são um cache do último cálculo (Fase 9-10); o histórico completo e
/// auditável de cada cálculo fica em FinancialCalculation.
model Installment {
  id                     String            @id @default(uuid()) @db.Uuid
  portfolioId            String            @db.Uuid
  sequence               Int
  label                  String
  dueDate                DateTime
  originalValue          Decimal           @db.Decimal(14, 2)
  correctedValue         Decimal?          @db.Decimal(14, 2)
  paidAmount             Decimal           @default(0) @db.Decimal(14, 2)
  lastCalculatedAt       DateTime?
  status                 InstallmentStatus @default(PENDING)
  // Marca a parcela de entrada (Fase A, Parte 4.1 — gatilho de liberação de
  // comissão "no recebimento da entrada"). Sem isso, teria que casar por
  // `label === "Entrada"` (frágil, o label é texto livre do fluxo).
  isDownPayment          Boolean           @default(false)
  // Fase B, Parte 2 (renegociação de parcelas) — quando uma parcela original
  // vira "Renegociada" (CANCELLED aqui, nunca apagada), `originAgreementId`
  // aponta pro acordo que a consumiu; quando uma parcela nova é criada por
  // um acordo, `destinationAgreementId` aponta pra ele. `correctionExempt`
  // só é setado nas parcelas de destino quando o acordo escolheu "sem
  // correção futura" — a parcela não aplica índice/juros contratuais na
  // correção ao vivo, mas ainda acumula multa/mora normalmente se vencer.
  originAgreementId      String?           @db.Uuid
  destinationAgreementId String?           @db.Uuid
  correctionExempt       Boolean           @default(false)
  createdAt              DateTime          @default(now())

  portfolio             ReceivablePortfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  payments              InstallmentPayment[]
  financialCalculations FinancialCalculation[]
  originAgreement       RenegotiationAgreement? @relation("RenegotiationOrigin", fields: [originAgreementId], references: [id], onDelete: SetNull)
  destinationAgreement  RenegotiationAgreement? @relation("RenegotiationDestination", fields: [destinationAgreementId], references: [id], onDelete: SetNull)

  @@unique([portfolioId, sequence])
  @@map("installments")
}

/// Recebimento (baixa manual) lançado contra uma parcela. Uma parcela pode
/// ter mais de um recebimento (pagamento parcial).
model InstallmentPayment {
  id              String   @id @default(uuid()) @db.Uuid
  installmentId   String   @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  paidAt          DateTime
  method          String? // ex.: "PIX", "Boleto", "TED" — texto livre até a Fase 17 (integração bancária)
  notes           String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@map("installment_payments")
}

enum IndexCode {
  INCC
  IPCA
  IGPM
  FIXED
}

/// Catálogo de índices da organização (PRD seção 12). Os valores mensais
/// (IndexValue) são cadastrados uma vez e reaproveitados por todos os
/// contratos que usam aquele índice.
model IndexRule {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @db.Uuid
  code                   IndexCode
  name                   String
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  // Dia do mês seguinte ao de competência até quando o valor deveria estar
  // publicado (ex.: IPCA costuma sair só no mês seguinte, perto do dia 10;
  // IGP-M sai perto do fim do próprio mês de competência). Nulo = usa o
  // padrão por código (V1 da auditoria de atualização, docs/
  // ESPEC_CONFIABILIDADE_JOBS_AUDITORIA.md).
  publicationDeadlineDay Int?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       IndexValue[]
  contracts    Contract[] // uso como índice de obra (pré-Habite-se)
  developments Development[] // uso como índice pós-Habite-se
  speInvestors SpeInvestor[] // uso como índice de correção de mútuo
  salesTables  SalesTable[] // uso como índice pré-Habite-se pra projeção de fluxo nominal da proposta

  @@unique([organizationId, code, name])
  @@map("index_rules")
}

enum IndexValueSource {
  MANUAL // lançado manualmente por alguém do Financeiro
  OFFICIAL // buscado automaticamente do Banco Central (SGS)
}

/// Variação percentual do índice em um mês de referência (ex.: INCC de
/// 07/2026 = 0,42%). A memória de cálculo de cada parcela referencia estes
/// valores, nunca os substitui.
model IndexValue {
  id             String           @id @default(uuid()) @db.Uuid
  indexRuleId    String           @db.Uuid
  referenceMonth DateTime // sempre normalizado para o dia 1 do mês
  ratePercent    Decimal          @db.Decimal(7, 4)
  source         IndexValueSource @default(MANUAL)
  createdAt      DateTime         @default(now())

  indexRule IndexRule @relation(fields: [indexRuleId], references: [id], onDelete: Cascade)

  @@unique([indexRuleId, referenceMonth])
  @@map("index_values")
}

enum InterestType {
  SIMPLE
  COMPOUND
}

/// Registro auditável de cada cálculo de correção de uma parcela (PRD seção
/// 12: "o sistema deve manter o índice utilizado em cada cálculo e nunca
/// simplesmente sobrescrever valores"). Nunca é atualizado, só criado.
model FinancialCalculation {
  id                    String   @id @default(uuid()) @db.Uuid
  installmentId         String   @db.Uuid
  asOfDate              DateTime
  baseValue             Decimal  @db.Decimal(14, 2)
  indexFactor           Decimal  @db.Decimal(10, 6)
  interestFactor        Decimal  @db.Decimal(10, 6)
  correctedValue        Decimal  @db.Decimal(14, 2) // valor na data de vencimento, já com índice + juros contratuais
  daysOverdue           Int
  fineAmount            Decimal  @db.Decimal(14, 2)
  overdueInterestAmount Decimal  @db.Decimal(14, 2)
  resultValue           Decimal  @db.Decimal(14, 2) // valor final na asOfDate (corrigido + multa + mora)
  details               Json // memória: meses/índices aplicados e parâmetros usados
  createdAt             DateTime @default(now())

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@map("financial_calculations")
}

// ============================================================================
// FASE 12 — FINANCEIRO DA INCORPORAÇÃO
// ============================================================================
//
// Escopo: Sprint 8 (docs/SPRINTS_INCORPORA.md) — contas a pagar, fornecedores,
// centros de custo e fluxo de caixa. Fluxo de aprovação da conta a pagar é
// sequencial (Lançada → Conferida → Aprovada → Programada → Paga →
// Conciliada), sem alçada por valor como nas propostas (PRD seção 16 não
// menciona alçada aqui). Rateio de uma despesa entre vários empreendimentos
// (mencionado no PRD) fica fora do V1 — cada conta pertence a no máximo um
// empreendimento; despesas da holding/organização inteira ficam com
// developmentId nulo. Documentado em docs/STATUS_IMPLANTACAO.md.

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  document       String? // CNPJ ou CPF
  email          String?
  phone          String?
  isActive       Boolean  @default(true)
  // Criado automaticamente (find-or-create) na primeira comissão liberada de
  // um corretor/imobiliária (Fase A, Parte 4.2 — "fornecedor = corretor/
  // imobiliária", sem lançamento manual duplicado), ou no primeiro distrato
  // de um cliente (Fase A, Parte 2.4 — devolução lançada como conta a
  // pagar, mesmo padrão de find-or-create). Nulos nos fornecedores "de
  // verdade" (construtora, cartório etc.).
  brokerId       String?  @unique @db.Uuid
  agencyId       String?  @unique @db.Uuid
  customerId     String?  @unique @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broker       Broker?           @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  agency       RealEstateAgency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payables     Payable[]

  @@map("suppliers")
}

/// Centro de custo — pode ser específico de um empreendimento (ex.: "Obra —
/// Torre A") ou da organização inteira (ex.: "Administração central").
model CostCenter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  developmentId  String?  @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development  Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  payables     Payable[]

  @@unique([organizationId, name])
  @@map("cost_centers")
}

enum PayableCategory {
  CONSTRUCTION // construtora
  LAND // terreno
  PROJECTS // projetos
  APPROVALS // aprovações
  NOTARY // cartório
  MARKETING
  AGENCY // agência
  MEDIA // mídia
  SALES_BOOTH // estande de vendas
  SALES_BOOTH_MAINTENANCE // manutenção do estande
  SALES_TEAM // equipe comercial
  BROKERAGE // corretagem
  FEES // taxas
  TAXES // impostos
  LEGAL // jurídico
  ACCOUNTING // contabilidade
  INSURANCE // seguros
  BANK_FEES // despesas bancárias
  UTILITIES // concessionárias
  ADMINISTRATION
  CANCELLATION_REFUND // devoluções de distrato
  OTHER // despesas diversas
}

enum PayableStatus {
  ENTERED // lançada
  REVIEWED // conferida
  APPROVED // aprovada
  SCHEDULED // programada
  PAID // paga
  RECONCILED // conciliada
  CANCELLED
}

/// Conta a pagar da incorporação (PRD seção 16).
model Payable {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  developmentId   String?         @db.Uuid // nulo = despesa da organização/holding
  speId           String?         @db.Uuid
  supplierId      String?         @db.Uuid
  costCenterId    String?         @db.Uuid
  category        PayableCategory
  description     String
  competenceDate  DateTime // mês de competência
  dueDate         DateTime
  amount          Decimal         @db.Decimal(14, 2)
  paymentMethod   String?
  bankAccount     String?
  fiscalDocument  String? // número da nota fiscal/documento
  contractId      String?         @db.Uuid // contrato relacionado (ex.: construtora), quando houver
  status          PayableStatus   @default(ENTERED)
  paidAt          DateTime?
  paidAmount      Decimal?        @db.Decimal(14, 2)
  notes           String?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development     Development?          @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  spe             SpecialPurposeEntity? @relation(fields: [speId], references: [id], onDelete: SetNull)
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  commissionSplit CommissionSplit?
  distrato        ContractDistrato?
  items           PayableItem[]
  allocations     PayableAllocation[]

  @@index([organizationId, status])
  @@index([organizationId, developmentId])
  @@map("payables")
}

/// Itens/composição de uma conta a pagar (Fase B, Parte 4.1) — detalhamento
/// opcional do valor total; quando presentes, a soma tem que bater exato com
/// `Payable.amount` (validado no servidor, não só na UI).
model PayableItem {
  id          String  @id @default(uuid()) @db.Uuid
  payableId   String  @db.Uuid
  description String
  amount      Decimal @db.Decimal(14, 2)
  sequence    Int

  payable Payable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([payableId])
  @@map("payable_items")
}

/// Rateio de uma conta a pagar entre N destinos (Fase B, Parte 4.2) —
/// `developmentId` nulo = destino "Organização". Ausência de linhas aqui pra
/// uma Payable = despesa 100% no `Payable.developmentId` (ou Organização, se
/// nulo) — mantém toda conta lançada antes desta etapa válida sem migração
/// de dados, exatamente como pedido na spec ("rateio de 100% num destino
/// só"). `percent` fica nulo quando o destino foi lançado em valor fixo;
/// `amount` é sempre o valor final calculado, pra toda agregação (relatórios,
/// fluxo de caixa) somar direto sem recalcular percentual.
model PayableAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  payableId     String   @db.Uuid
  developmentId String?  @db.Uuid
  percent       Decimal? @db.Decimal(5, 2)
  amount        Decimal  @db.Decimal(14, 2)
  sequence      Int

  payable     Payable      @relation(fields: [payableId], references: [id], onDelete: Cascade)
  development Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  @@index([payableId])
  @@index([developmentId])
  @@map("payable_allocations")
}

/// Modelo de rateio salvo pra reuso (ex.: "Administrativo 50/30/20") — só
/// percentuais por destino; aplicar contra uma Payable recalcula os valores
/// em cima do valor total daquela conta.
model AllocationTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinations AllocationTemplateDestination[]

  @@unique([organizationId, name])
  @@map("allocation_templates")
}

model AllocationTemplateDestination {
  id            String  @id @default(uuid()) @db.Uuid
  templateId    String  @db.Uuid
  developmentId String? @db.Uuid
  percent       Decimal @db.Decimal(5, 2)
  sequence      Int

  template    AllocationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  development Development?       @relation(fields: [developmentId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("allocation_template_destinations")
}

enum ReceivableCategory {
  ASSIGNMENT_FEE // taxa de cessão
  SPACE_RENTAL // aluguel de espaço (estande, área comum...)
  REFUND // reembolso
  YIELD // rendimento
  OTHER
}

enum ReceivableStatus {
  PENDING
  RECEIVED
  CANCELLED
}

/// Recebível avulso (Fase B, Parte 4.3) — entrada que não nasce de venda
/// (taxa de cessão, aluguel de espaço, reembolso, rendimento). Deliberadamente
/// SEM motor de correção monetária (a spec pede "não mistura com o motor de
/// correção") e sem depender de `ReceivablePortfolio`/`Installment` — espelha
/// o padrão já usado em `Payable` (origem, categoria, empreendimento/SPE
/// opcional, vencimento, valor), o par estrutural mais próximo do que a spec
/// pede, em vez de forçar mais uma parcela na carteira de vendas.
model Receivable {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid
  developmentId        String?            @db.Uuid
  speId                String?            @db.Uuid
  customerId           String?            @db.Uuid // cliente/pagador, opcional
  category             ReceivableCategory
  origin               String // descrição da origem (ex.: "Taxa de cessão CT-2026-0001-CS01")
  dueDate              DateTime
  amount               Decimal            @db.Decimal(14, 2)
  status               ReceivableStatus   @default(PENDING)
  receivedAt           DateTime?
  receivedAmount       Decimal?           @db.Decimal(14, 2)
  notes                String?
  contractAssignmentId String?            @unique @db.Uuid // origem automática (taxa de cessão) — rastreabilidade, nunca criado manualmente pra esse caso
  createdByUserId      String?            @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  development        Development?          @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  spe                SpecialPurposeEntity? @relation(fields: [speId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractAssignment ContractAssignment?   @relation(fields: [contractAssignmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, developmentId])
  @@map("receivables")
}
